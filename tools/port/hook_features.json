{
 "_comment": "Owning feature per patched stock site, by the purpose text the builders give each write (first matching rule wins). group = BENTO_DISABLE group that owns the site (R6.19, ratchets branch: blackbox, monoroll, ratchets). note = a standing remark shown as a drop candidate. hooksig.py lists every site no rule matches.",
 "rules": [
  {"match": "^R6\\.18 black box", "feature": "black box (R6.18)", "group": "blackbox"},
  {"match": "^R6\\.13 ratchet", "feature": "ratchets (R6.13)", "group": "ratchets"},
  {"match": "^R6\\.6 transpose", "feature": "transpose (R6.6)"},
  {"match": "^MPU A/B", "feature": "widened M4 MPU (bank-1 UI code)"},
  {"match": "^Playground palette / release identity|^Visible experiment identifier", "feature": "identity and palette"},
  {"match": "^Reserve \\d+ bytes", "feature": "RAM reservation"},
  {"match": "^(UI )?startup branch$|^consumer branch$|^input branch$", "feature": "core plumbing (startup, input, button consumer)"},
  {"match": "^Launch native layout", "feature": "Playground Launch screen", "note": "owner decision for 1.6.8: take the native Launch pad lighting and drop our overlapping routines (review which of the five view slots that covers)"},
  {"match": "^CH6 chord pad audition", "feature": "chord pad audition (CH6)"},
  {"match": "^CH6 piano-grid lanes", "feature": "piano-grid lanes (CH6)"},
  {"match": "^CH1 |^CH5 ", "feature": "chord composer (CH1/CH5)"},
  {"match": "^CH11 ", "feature": "Mod Matrix synth destinations (CH11)"},
  {"match": "^P8 mod mode", "feature": "Mod mode view (P8)"},
  {"match": "^CH9 meter", "feature": "Track FX meter (CH9)"},
  {"match": "Track FX|custom FX rows|parameter-row menu", "feature": "Track FX (TF2)"},
  {"match": "^Carrier listing filter", "feature": "browser carrier filter"},
  {"match": "^EU10 |^W14 ", "feature": "Euclidean sequencer and Select (EU10)"},
  {"match": "^A1 |^P4 Analog", "feature": "Analog instrument (A1)"},
  {"match": "^Arp ", "feature": "arpeggiator"},
  {"match": "^T2 ", "feature": "trigger conditions (T2)"},
  {"match": "^L3 ", "feature": "step locks (L3)"},
  {"match": "^P14 |^P15 |^Native A-D send", "feature": "melodic locks and per-note sends (P14/P15)"},
  {"match": "^P12 |^P20 |^Persistent header", "feature": "header actions (P12/P20)"},
  {"match": "^P1 fixed velocity", "feature": "fixed velocity (P1)"},
  {"match": "^K7 |^K13 |^K15 |^Drum selection|^Prepare built-in kick|frozen custom drum|^P6 Drum Synth|^Leave custom mode|^Unlit empty steps", "feature": "drum synth (K series)"},
  {"match": "^W22 ", "feature": "PLAY mutes and waveform text (W22)"},
  {"match": "^G1 |^G2 |^G12 |^P27 |^P29 |^W5 |^W7 |^Native mixer render|^Bound four Perform|^Minimalist INST|^INST native static-label|^W14 centre", "feature": "Playground screens (Tracks, Mixer, Perform, INST)"},
  {"match": "^Cancel dequeued native Save", "feature": "save guard"},
  {"match": "per-sound cycle metadata", "feature": "cycle Undo"}
 ]
}
